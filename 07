import math
import torch
import torch.nn as nn
import torch.optim as optim
import numpy as np


class SingularityTraversalLayer(nn.Module):
    """
    Core Traversal Layer designed by Bryan Houk (@BryGemi).
    
    Transforms input state vectors across a continuous 2D complex phase plane 
    via exact 4th-Order Runge-Kutta (RK4) integration or analytical matrix 
    exponentiation exp(M * dt), completely bypassing singular gradient divergence.
    """
    def __init__(self, in_features: int, out_features: int, phi_deg: float = 12.7328, scale_a: float = -3.0, step_size: float = 0.1, mode: str = "rk4"):
        super(SingularityTraversalLayer, self).__init__()
        
        if out_features % 2 != 0:
            raise ValueError("out_features must be an even integer to form 2D complex phase pairs.")

        self.in_features = in_features
        self.out_features = out_features
        self.mode = mode.lower()
        self.step_size = step_size
        
        # Primary Learnable Weights
        self.weight = nn.Parameter(torch.Tensor(out_features, in_features))
        self.bias = nn.Parameter(torch.Tensor(out_features))
        
        # Exact Physical Parameters (Differentiable)
        phi_rad = math.radians(phi_deg)
        self.phi = nn.Parameter(torch.tensor(phi_rad, dtype=torch.float32))
        self.scale_a = nn.Parameter(torch.tensor(scale_a, dtype=torch.float32))
        
        # Kaiming Uniform Initialization
        nn.init.kaiming_uniform_(self.weight, a=math.sqrt(5))
        nn.init.zeros_(self.bias)

    def _get_transformation_matrix(self, dtype: torch.dtype, device: torch.device) -> torch.Tensor:
        """
        Constructs the exact 2x2 complex real-representation transformation matrix M:
        M = a * [[ Re(z), -Im(z) ],
                 [ Im(z),  Re(z) ]]
        where z = (1 / sqrt(2)) * exp(i * phi)
        """
        inv_sqrt_2 = 1.0 / math.sqrt(2.0)
        z_real = inv_sqrt_2 * torch.cos(self.phi)
        z_imag = inv_sqrt_2 * torch.sin(self.phi)
        
        row1 = torch.stack([self.scale_a * z_real, -self.scale_a * z_imag])
        row2 = torch.stack([self.scale_a * z_imag,  self.scale_a * z_real])
        
        M = torch.stack([row1, row2])
        return M.to(dtype=dtype, device=device)

    def rk4_step(self, x_state: torch.Tensor, M: torch.Tensor) -> torch.Tensor:
        """Executes 4th-Order Runge-Kutta numerical path tracking across phase space."""
        dt = self.step_size
        M_T = M.T
        
        k1 = torch.matmul(x_state, M_T)
        k2 = torch.matmul(x_state + 0.5 * dt * k1, M_T)
        k3 = torch.matmul(x_state + 0.5 * dt * k2, M_T)
        k4 = torch.matmul(x_state + dt * k3, M_T)
        
        return x_state + (dt / 6.0) * (k1 + 2.0 * k2 + 2.0 * k3 + k4)

    def matrix_exp_step(self, x_state: torch.Tensor, M: torch.Tensor) -> torch.Tensor:
        """Executes exact continuous matrix exponential trajectory: x(t) = x_0 * exp(M * dt)^T."""
        dt = self.step_size
        M_exp = torch.linalg.matrix_exp(M * dt)
        return torch.matmul(x_state, M_exp.T)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        # Linear State Mapping
        projected = torch.matmul(x, self.weight.T) + self.bias
        
        # Pairwise Complex Phase Transformation
        batch_size = projected.size(0)
        num_pairs = self.out_features // 2
        paired = projected.view(batch_size, num_pairs, 2)
        
        M = self._get_transformation_matrix(x.dtype, x.device)
        
        if self.mode == "expm":
            traversed_pairs = self.matrix_exp_step(paired, M)
        else:
            traversed_pairs = self.rk4_step(paired, M)
            
        return traversed_pairs.view(batch_size, self.out_features)


class BATLEnginePipeline(nn.Module):
    """
    Complete BATL Software Engine Pipeline.
    
    Integrates multi-layer singularity traversal blocks with continuous telemetry 
    logging, gradient tracking, and dynamic trajectory stability controls.
    """
    def __init__(self, input_dim: int, hidden_dim: int, output_dim: int, phi_deg: float = 12.7328, scale_a: float = -3.0):
        super(BATLEnginePipeline, self).__init__()
        
        self.author = "Bryan Houk (@BryGemi)"
        self.version = "BATL Engine v0.7"
        
        # Neural Traversal Layers
        self.layer1 = SingularityTraversalLayer(input_dim, hidden_dim, phi_deg=phi_deg, scale_a=scale_a, mode="rk4")
        self.layer2 = SingularityTraversalLayer(hidden_dim, hidden_dim, phi_deg=phi_deg, scale_a=scale_a, mode="expm")
        self.projection_out = nn.Linear(hidden_dim, output_dim)
        
    def forward(self, x: torch.Tensor) -> torch.Tensor:
        h1 = self.layer1(x)
        h2 = self.layer2(h1)
        out = self.projection_out(h2)
        return out


